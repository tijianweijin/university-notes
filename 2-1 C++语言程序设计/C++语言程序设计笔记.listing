const int arraySize = 100;

void bubbleSort() {
    int pos = arraySize - 1;
    while (pos) {
        int bound = pos;
        pos = 0;
        for (int i = 0; i < bound; i++) {
            if (a[i] > a[i + 1]) {
                int hold = a[i];
                a[i] = a[i + 1];
                a[i + 1] = hold;
                pos = i;
            }
        }
    }
}
